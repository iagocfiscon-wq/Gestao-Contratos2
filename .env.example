# Servidor
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
SESSION_TTL_HOURS=8
RATE_LIMIT_MAX=120

# Provisionamento inicial; defina somente no ambiente local/seguro
ADMIN_USERNAME=admin
ADMIN_NAME=Administrador do sistema
